<UserControl x:Class="WindowsUtilityPack.Tools.SystemUtilities.AutomationRules.AutomationRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WindowsUtilityPack.Models">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Automation Rules" Style="{StaticResource ToolTitleTextStyle}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource ToolPanelBorderStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button AutomationProperties.AutomationId="AddCommand" Content="Add" Command="{Binding AddCommand}" Margin="0,0,8,0" Style="{StaticResource PrimaryActionButtonStyle}"/>
                <Button AutomationProperties.AutomationId="SaveCommand" Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                <Button AutomationProperties.AutomationId="DeleteCommand" Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,8,0" Style="{StaticResource DangerActionButtonStyle}"/>
                <Button AutomationProperties.AutomationId="RefreshCommand" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ToolPanelBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Templates and Dry-Run" Style="{StaticResource SectionHeadingTextStyle}" Margin="0,0,0,8"/>
                <WrapPanel>
                    <ComboBox AutomationProperties.AutomationId="SelectedTemplate" Width="250"
                              Margin="0,0,8,8"
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                    <Button AutomationProperties.AutomationId="AddFromTemplateCommand" Content="Add From Template"
                            Margin="0,0,12,8"
                            Command="{Binding AddFromTemplateCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"/>

                    <TextBlock Text="Disk Free (GB)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox AutomationProperties.AutomationId="SimulationDiskFreeGb" Width="70" Margin="0,0,8,8" Text="{Binding SimulationDiskFreeGb, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="CPU (%)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox AutomationProperties.AutomationId="SimulationCpuPercent" Width="60" Margin="0,0,8,8" Text="{Binding SimulationCpuPercent, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="RAM (%)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox AutomationProperties.AutomationId="SimulationRamPercent" Width="60" Margin="0,0,8,8" Text="{Binding SimulationRamPercent, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Disk used (%)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox AutomationProperties.AutomationId="SimulationDiskUsagePercent" Width="60" Margin="0,0,8,8" Text="{Binding SimulationDiskUsagePercent, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Processes" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox AutomationProperties.AutomationId="SimulationProcessCount" Width="60" Margin="0,0,8,8" Text="{Binding SimulationProcessCount, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button AutomationProperties.AutomationId="RunDryRunCommand" Content="Run Dry-Run" Margin="0,0,0,8" Command="{Binding RunDryRunCommand}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ToolPanelBorderStyle}" Margin="0,0,0,12">
                <DataGrid AutomationProperties.AutomationId="SelectedRule" ItemsSource="{Binding RuleItems}"
                          SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=TwoWay}" Width="80"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                        <DataGridTemplateColumn Header="Trigger" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox AutomationProperties.AutomationId="TriggerType" SelectedItem="{Binding TriggerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.TriggerTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Cooldown (min)" Binding="{Binding CooldownMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                        <DataGridTemplateColumn Header="Action" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox AutomationProperties.AutomationId="ActionType" SelectedItem="{Binding ActionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.ActionTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Action Target"
                                            Width="220"
                                            Binding="{Binding ActionTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource ToolPanelBorderStyle}">
                <DataGrid AutomationProperties.AutomationId="SimulationResults" ItemsSource="{Binding SimulationResults}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Triggered" Binding="{Binding Triggered}" Width="90"/>
                        <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="220"/>
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource StatusSurfaceStyle}">
            <TextBlock AutomationProperties.AutomationId="StatusMessage" Text="{Binding StatusMessage}" Style="{StaticResource MetadataTextStyle}"/>
        </Border>
    </Grid>
</UserControl>
